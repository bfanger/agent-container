{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-swap/Qwen3.8-MTP-q4",
  "provider": {
    "llama-swap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap",
      "options": {
        "baseURL": "http://host.docker.internal:8080/v1"
      },
      "models": {
        "Qwen3.8-MTP-q4": {
          "name": "Qwen 3.8 - MTP 56K q4",
          "limit": {
            "context": 56000,
            "input": 56000,
            "output": 32000
          }
        },
        "Qwen3.8-Vision": {
          "name": "Qwen 3.8 Vision - 40K q4",
          "limit": {
            "context": 40000,
            "input": 40000,
            "output": 32000
          }
        },
        "Qwen3.8-q4": {
          "name": "Qwen 3.8 Context - 110K q4",
          "limit": {
            "context": 110000,
            "input": 110000,
            "output": 32000
          }
        },
        "Qwen3.8-MTP-q8": {
          "name": "Qwen 3.8 KV - MTP 43K q8",
          "limit": {
            "context": 43000,
            "input": 43000,
            "output": 32000
          }
        },
        "Qwen3.6-MTP-q4": {
          "name": "Qwen 3.6 - MTP 56K q4",
          "limit": {
            "context": 56000,
