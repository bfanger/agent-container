{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-swap/qwen3.8-swift",
  "provider": {
    "llama-swap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap",
      "options": {
        "baseURL": "http://host.docker.internal:9931/v1"
      },
      "models": {
        "qwen3.8-swift": {
          "name": "Qwen 3.8 Swift - MTP 80K q4",
          "limit": {
            "context": 80000,
            "input": 80000,
            "output": 32000
          }
        },
        "qwen3.8-vision": {
          "name": "Qwen 3.8 Vision - 64K q4",
          "limit": {
            "context": 64000,
            "input": 64000,
            "output": 32000
          }
        },
        "qwen3.8-context": {
          "name": "Qwen 3.8 Context - 160K q4",
          "limit": {
            "context": 160000,
            "input": 160000,
            "output": 32000
          }
        },
        "qwen3.8-vram": {
          "name": "Qwen 3.8 - 30K q4",
          "limit": {
            "context": 30000,
            "input": 30000,
            "output": 32000
          }
        },
        "qwen3.8-mtp-q8": {
          "name": "Qwen 3.8 KV - MTP 43K q8",
          "limit": {
            "context": 43000,
            "input": 43000,
            "output": 32000
          }
        },
        "qwen3.8-unsloth": {
          "name": "Qwen 3.8 - MTP 56K q4 unsloth",
          "limit": {
            "context": 56000,
            "input": 56000,
            "output": 32000
          }
        },
        "qwen3.6-mtp-q4": {
          "name": "Qwen 3.6 - MTP 56K q4",
          "limit": {
            "context": 56000,
            "input": 56000,
            "output": 32000
          }
        },
        "qwen3.6-q8": {
          "name": "Qwen 3.6 - 50K q8",
          "limit": {
            "context": 50000,
            "input": 50000,
            "output": 32000
          }
        },
        "qwen3.6-q4": {
          "name": "Qwen 3.6 Context - 110K q4",
          "limit": {
            "context": 110000,
            "input": 110000,
            "output": 32000
          }
        },
        "qwen3.6-mtp-q8": {
          "name": "Qwen 3.6 KV - MTP 40K q8",
          "limit": {
            "context": 40000,
            "input": 40000,
            "output": 32000
          }
        },
        "muse-glimmer": {
          "name": "Muse Glimmer - 131K",
          "limit": {
            "context": 131000,
            "input": 131000,
            "output": 32000
          }
        },
        "muse-glimmer-f16": {
          "name": "Muse Glimmer - 100K f16",
          "limit": {
            "context": 100000,
            "input": 100000,
            "output": 32000
          }
        },
        "muse-glimmer-dflash": {
          "name": "Muse Glimmer - DFlash 80K",
          "limit": {
            "context": 80000,
            "input": 80000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser=firefox"],
      "enabled": false
    }
  }
}
